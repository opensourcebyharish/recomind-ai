# RecoMind AI Environment Variables (example)
# Copy to .env and fill values as needed. Do NOT commit .env

# Application
APP_NAME=RecoMind AI
APP_ENV=development
DEBUG=false
LOG_LEVEL=INFO
API_V1_STR=/api/v1
SECRET_KEY=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Database
DATABASE_URL=sqlite:///./recomind.db

# CORS
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Frontend
VITE_API_BASE_URL=http://localhost:8000

# TMDB API (optional - for browsing real movie catalog)
# Get your API key from https://www.themoviedb.org/settings/api
# TMDB_API_KEY=your_api_key_here

# ML / Data paths (optional overrides)
DATA_RAW_DIR=./data/raw
DATA_PROCESSED_DIR=./data/processed
ML_ARTIFACTS_DIR=./data/models
